EXPO_API_HOST=127.0.0.1
EXPO_API_PORT=8001
# Only for server-side authenticated admin edits. Do not include in Swift client.
EXPO_ADMIN_TOKEN=change-me-to-a-long-random-secret
# EXPO_DB_PATH=/absolute/path/to/expo.sqlite3

# User-owned accounts / career profiles / plans / journey records.
EXPO_USER_DATABASE=./instance/expo_users.sqlite3
# URL used in optional public professional-profile links. Configure HTTPS for deployment.
EXPO_PUBLIC_BASE_URL=http://127.0.0.1:8001

# Email verification is disabled: account registration requires no SMTP settings.
# NOTE: password recovery by email is not implemented in this development build.

# Gemini AI planner — server only, NEVER put this key in Xcode or commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
